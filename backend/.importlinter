[importlinter]
root_package = onboarder
include_external_packages = True

[importlinter:contract:core_forbidden_dependencies]
name = Core excludes frameworks and outer layers
type = forbidden
source_modules =
    onboarder.core
forbidden_modules =
    fastapi
    sqlalchemy
    psycopg
    typer
    onboarder.cli

[importlinter:contract:services_forbidden_dependencies]
name = Services depend on protocols, not infrastructure or frameworks
type = forbidden
source_modules =
    onboarder.services.*
forbidden_modules =
    onboarder.db
    sqlalchemy
    psycopg
    fastapi
    typer

[importlinter:contract:db_forbidden_api]
name = Database layer excludes the API framework
type = forbidden
source_modules =
    onboarder.db.*
forbidden_modules =
    fastapi